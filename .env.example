# URL del backend-ciisic (sin /api/v1). La usa solo el servidor Nitro (BFF).
NUXT_BACKEND_BASE_URL=http://localhost:3010
# Duración de la sesión en segundos (igual a la expiración del JWT del backend)
NUXT_SESSION_MAX_AGE=3600
# Enlace a la landing pública (para "Ver sitio")
NUXT_PUBLIC_LANDING_URL=https://ciisic-viii.episundc.pe
