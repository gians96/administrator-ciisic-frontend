{
  "name": "administrator-ciisic-frontend",
  "private": true,
  "type": "module",
  "description": "Panel administrativo del congreso CIISIC (UNDC): eventos, inscripciones, tipos de inscripción, consultas DNI e integraciones.",
  "scripts": {
    "dev": "nuxt dev --port 3001",
    "build": "nuxt build",
    "preview": "nuxt preview --port 3001",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "escaner:wasm": "node -e \"const fs=require('node:fs');const v=require('./node_modules/zxing-wasm/package.json').version;const d='public/zxing-wasm/'+v;fs.mkdirSync(d,{recursive:true});fs.copyFileSync('node_modules/zxing-wasm/dist/reader/zxing_reader.wasm',d+'/zxing_reader.wasm');console.log(d+'/zxing_reader.wasm')\""
  },
  "dependencies": {
    "@nuxt/icon": "^2.5.1",
    "@pinia/nuxt": "^1.0.2",
    "chart.js": "^4.5.1",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-qrcode-reader": "^5.7.3"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@nuxt/eslint": "^1.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.39.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.11"
  }
}
